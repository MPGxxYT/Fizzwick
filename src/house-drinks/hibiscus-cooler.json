{
  "formatVersion": 1,
  "id": "hibiscus-cooler",
  "name": "Hibiscus Cooler",
  "glass": "collins",
  "method": "build",
  "flavorTags": ["fruity", "citrus"],
  "shelf": "iced-tea-coolers",
  "added": "2026-11-06",
  "photo": "photos/hibiscus-cooler.jpg",
  "sip": { "by": "rim", "why": "so you smell the garnish and get the bubbles at the top." },
  "ingredients": [
    { "name": "chilled hibiscus tea", "amount": 4, "unit": "oz" },
    { "name": "fresh lime juice", "amount": 0.25, "unit": "oz" },
    { "name": "ice", "unit": "fill" }
  ],
  "slots": [
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "honey-syrup",
          "label": "Honey syrup",
          "phrase": "honey syrup",
          "ingredients": [{ "name": "honey syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#e0a43a"
        },
        {
          "id": "agave",
          "label": "Agave",
          "phrase": "agave",
          "ingredients": [{ "name": "agave", "amount": 0.25, "unit": "oz" }],
          "color": "#d9a441"
        },
        {
          "id": "ginger-syrup",
          "label": "Ginger syrup",
          "phrase": "ginger syrup",
          "ingredients": [{ "name": "ginger syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#d6a345"
        }
      ]
    },
    {
      "id": "fizz",
      "label": "Fizz",
      "options": [
        {
          "id": "soda-water",
          "label": "Soda water",
          "phrase": "soda water",
          "ingredients": [{ "name": "soda water", "unit": "top" }],
          "color": "#e0f2fe"
        },
        {
          "id": "ginger-ale",
          "label": "Ginger ale",
          "phrase": "ginger ale",
          "ingredients": [{ "name": "ginger ale", "unit": "top" }],
          "color": "#f1d38a"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "lime-wheel",
          "label": "Lime wheel",
          "phrase": "a lime wheel",
          "ingredients": [{ "name": "lime wheel", "amount": 1, "unit": "count" }],
          "color": "#84cc16"
        },
        {
          "id": "orange-wheel",
          "label": "Orange wheel",
          "phrase": "an orange wheel",
          "ingredients": [{ "name": "orange wheel", "amount": 1, "unit": "count" }],
          "color": "#f97316"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "brew-tea",
      "text": "Steep the hibiscus tea in just-boiled water, then strain it and chill it in the fridge. Make it ahead if you can.",
      "tools": ["kettle"],
      "durationSeconds": 300
    },
    {
      "id": "add-base",
      "text": "Stir the {sweetener} and lime juice together in a Collins glass.",
      "tools": ["jigger", "barspoon"]
    },
    { "id": "fill-glass", "text": "Fill the glass with ice." },
    {
      "id": "pour-tea",
      "text": "Pour the hibiscus tea over the ice, leaving room at the top.",
      "tools": ["jigger"]
    },
    {
      "id": "top",
      "text": "Top with {fizz} and stir once with a barspoon.",
      "tools": ["barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "sweetener": "simple-syrup",
    "fizz": "soda-water",
    "garnish": "lime-wheel"
  }
}
