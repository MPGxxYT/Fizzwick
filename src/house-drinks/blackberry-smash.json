{
  "formatVersion": 1,
  "id": "blackberry-smash",
  "name": "Blackberry Smash",
  "glass": "rocks",
  "method": "shake",
  "flavorTags": ["fruity", "herbal"],
  "photo": "photos/blackberry-smash.jpg",
  "ingredients": [
    { "name": "fresh lemon juice", "amount": 0.5, "unit": "oz" },
    { "name": "crushed ice", "unit": "fill" },
    { "name": "soda water", "amount": 2, "unit": "oz" }
  ],
  "slots": [
    {
      "id": "blackberry",
      "label": "Blackberries",
      "options": [
        {
          "id": "fresh-blackberries",
          "label": "Fresh blackberries",
          "phrase": "blackberries",
          "ingredients": [{ "name": "blackberries", "amount": 8, "unit": "count" }],
          "color": "#3b1f4a"
        },
        {
          "id": "frozen-blackberries",
          "label": "Frozen blackberries, thawed",
          "phrase": "thawed blackberries",
          "ingredients": [{ "name": "frozen blackberries, thawed", "amount": 8, "unit": "count" }],
          "color": "#2e1a3d"
        }
      ]
    },
    {
      "id": "herb",
      "label": "Herb",
      "optional": true,
      "options": [
        {
          "id": "mint",
          "label": "Mint",
          "phrase": "mint leaves",
          "ingredients": [{ "name": "mint leaves", "amount": 6, "unit": "count" }],
          "color": "#6fcf6a"
        },
        {
          "id": "sage",
          "label": "Sage",
          "phrase": "sage leaves",
          "ingredients": [{ "name": "sage leaves", "amount": 3, "unit": "count" }],
          "color": "#8aa37b"
        },
        {
          "id": "thyme",
          "label": "Thyme",
          "phrase": "thyme sprigs",
          "ingredients": [{ "name": "thyme sprigs", "amount": 2, "unit": "count" }],
          "color": "#6b8e4e"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "honey-syrup",
          "label": "Honey syrup",
          "phrase": "honey syrup",
          "ingredients": [{ "name": "honey syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#e0a43a"
        },
        {
          "id": "demerara-syrup",
          "label": "Demerara syrup",
          "phrase": "demerara syrup",
          "ingredients": [{ "name": "demerara syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#b5772f"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "blackberry-pick",
          "label": "Blackberries on a pick",
          "phrase": "a few blackberries on a cocktail pick",
          "ingredients": [{ "name": "blackberries, on a cocktail pick", "amount": 3, "unit": "count" }],
          "color": "#4a2560"
        },
        {
          "id": "lemon-wheel",
          "label": "Lemon wheel",
          "phrase": "a lemon wheel",
          "ingredients": [{ "name": "lemon wheel", "amount": 1, "unit": "count" }],
          "color": "#fde047"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "muddle-berries",
      "text": "Muddle the {blackberry} in a shaker tin until they burst.",
      "tools": ["muddler", "shaker"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb} and press them gently with the muddler, just enough to bruise them.",
      "tools": ["muddler"],
      "when": { "slot": "herb" }
    },
    {
      "id": "add-base",
      "text": "Add the lemon juice and {sweetener}.",
      "tools": ["jigger"]
    },
    {
      "id": "shake",
      "text": "Fill the tin with ice and shake hard for about 10 seconds.",
      "tools": ["shaker"]
    },
    { "id": "fill-glass", "text": "Fill a rocks glass with crushed ice." },
    {
      "id": "strain",
      "text": "Double strain into the glass, through the shaker strainer and a fine strainer, to catch the seeds and bits of leaf.",
      "tools": ["strainer", "fine-strainer"]
    },
    {
      "id": "add-soda",
      "text": "Pour the soda water over the top and stir once with a barspoon.",
      "tools": ["jigger", "barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "blackberry": "fresh-blackberries",
    "herb": "sage",
    "sweetener": "simple-syrup",
    "garnish": "blackberry-pick"
  }
}
