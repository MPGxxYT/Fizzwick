{
  "formatVersion": 1,
  "id": "black-tea-old-fashioned",
  "name": "Black Tea Old Fashioned",
  "glass": "rocks",
  "method": "stir",
  "flavorTags": ["bitter", "smoky"],
  "photo": "photos/black-tea-old-fashioned.jpg",
  "ingredients": [
    { "name": "unsweetened cranberry juice", "amount": 0.5, "unit": "oz" },
    { "name": "alcohol-free aromatic bitters", "amount": 2, "unit": "dash" },
    { "name": "large ice cube", "amount": 1, "unit": "count" }
  ],
  "slots": [
    {
      "id": "tea",
      "label": "Tea",
      "options": [
        {
          "id": "black-tea",
          "label": "Chilled strong black tea",
          "phrase": "black tea",
          "ingredients": [{ "name": "chilled strong black tea", "amount": 2, "unit": "oz" }],
          "dietaryTags": ["caffeine"],
          "color": "#8a4b1f"
        },
        {
          "id": "lapsang-souchong",
          "label": "Chilled lapsang souchong",
          "phrase": "lapsang souchong",
          "ingredients": [{ "name": "chilled lapsang souchong", "amount": 2, "unit": "oz" }],
          "dietaryTags": ["caffeine"],
          "color": "#5c3317"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "demerara-syrup",
          "label": "Demerara syrup",
          "phrase": "demerara syrup",
          "ingredients": [{ "name": "demerara syrup", "amount": 0.25, "unit": "oz" }],
          "color": "#a16207"
        },
        {
          "id": "maple-syrup",
          "label": "Maple syrup",
          "phrase": "maple syrup",
          "ingredients": [{ "name": "maple syrup", "amount": 0.25, "unit": "oz" }],
          "color": "#b45309"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "options": [
        {
          "id": "orange-peel",
          "label": "Expressed orange peel",
          "ingredients": [{ "name": "orange peel", "amount": 1, "unit": "count" }],
          "color": "#f97316"
        },
        {
          "id": "cocktail-cherry",
          "label": "Cocktail cherry",
          "ingredients": [{ "name": "cocktail cherry", "amount": 1, "unit": "count" }],
          "color": "#7f1d1d"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "steep-tea",
      "text": "Steep the {tea} strong in just-boiled water, using twice the usual amount of tea, then strain it and chill it in the fridge. Make it ahead if you can.",
      "tools": ["kettle"],
      "durationSeconds": 240
    },
    {
      "id": "add-base",
      "text": "Pour the {tea}, {sweetener}, cranberry juice and 2 dashes of bitters into a mixing glass.",
      "tools": ["jigger", "mixing-glass"]
    },
    {
      "id": "stir",
      "text": "Fill the mixing glass with ice and stir smoothly with a barspoon until the outside of the glass is cold.",
      "tools": ["mixing-glass", "barspoon"],
      "durationSeconds": 30
    },
    { "id": "add-cube", "text": "Put one large ice cube in a rocks glass." },
    {
      "id": "strain",
      "text": "Strain the drink over the cube.",
      "tools": ["strainer"]
    },
    {
      "id": "express-peel",
      "text": "Squeeze the orange peel skin side down over the glass to spray its oils across the top, rub it around the rim, then drop it in.",
      "tools": ["peeler"],
      "when": { "slot": "garnish", "option": "orange-peel" }
    },
    {
      "id": "garnish-cherry",
      "text": "Drop a cocktail cherry into the glass.",
      "when": { "slot": "garnish", "option": "cocktail-cherry" }
    }
  ],
  "houseSpec": {
    "tea": "black-tea",
    "sweetener": "demerara-syrup",
    "garnish": "orange-peel"
  }
}
