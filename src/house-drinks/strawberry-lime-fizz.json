{
  "formatVersion": 1,
  "id": "strawberry-lime-fizz",
  "name": "Strawberry Lime Fizz",
  "glass": "highball",
  "method": "shake",
  "flavorTags": ["fruity", "citrus"],
  "shelf": "fizzy-fruity",
  "added": "2026-11-05",
  "photo": "photos/strawberry-lime-fizz.jpg",
  "sip": { "by": "rim", "why": "so you smell the garnish and get the bubbles at the top." },
  "ingredients": [
    { "name": "ice", "unit": "fill" },
    { "name": "fresh lime juice", "amount": 0.5, "unit": "oz" }
  ],
  "slots": [
    {
      "id": "strawberry",
      "label": "Strawberries",
      "options": [
        {
          "id": "fresh-strawberries",
          "label": "Fresh strawberries",
          "phrase": "strawberries",
          "ingredients": [{ "name": "fresh strawberries, hulled", "amount": 3, "unit": "count", "size": { "each": "walnut-size" } }],
          "color": "#e63946"
        },
        {
          "id": "frozen-strawberries",
          "label": "Frozen strawberries, thawed",
          "phrase": "thawed strawberries",
          "ingredients": [{ "name": "frozen strawberries", "amount": 3, "unit": "count", "size": { "each": "walnut-size" } }],
          "color": "#c2283a"
        }
      ]
    },
    {
      "id": "herb",
      "label": "Herb",
      "optional": true,
      "options": [
        {
          "id": "mint",
          "label": "Mint",
          "phrase": "mint leaves",
          "ingredients": [{ "name": "mint leaves", "amount": 6, "unit": "count", "size": { "each": "thumbnail-size" } }],
          "color": "#6fcf6a"
        },
        {
          "id": "basil",
          "label": "Basil",
          "phrase": "basil leaves",
          "ingredients": [{ "name": "basil leaves", "amount": 2, "unit": "count", "size": { "each": "thumb-length" } }],
          "color": "#3f9d4a"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "honey-syrup",
          "label": "Honey syrup",
          "phrase": "honey syrup",
          "ingredients": [{ "name": "honey syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#e0a43a"
        },
        {
          "id": "agave",
          "label": "Agave",
          "phrase": "agave",
          "ingredients": [{ "name": "agave", "amount": 0.25, "unit": "oz" }],
          "color": "#d9a441"
        }
      ]
    },
    {
      "id": "fizz",
      "label": "Fizz",
      "options": [
        {
          "id": "soda-water",
          "label": "Soda water",
          "phrase": "soda water",
          "ingredients": [{ "name": "soda water", "unit": "top" }],
          "color": "#e0f2fe"
        },
        {
          "id": "lemon-lime-soda",
          "label": "Lemon-lime soda",
          "phrase": "lemon-lime soda",
          "ingredients": [{ "name": "lemon-lime soda", "unit": "top" }],
          "color": "#e7f5c4"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "fresh-strawberry",
          "label": "Strawberry on the rim",
          "phrase": "a strawberry, cut halfway up and set on the rim",
          "ingredients": [{ "name": "fresh strawberry", "amount": 1, "unit": "count" }],
          "color": "#f25c6b"
        },
        {
          "id": "lime-wheel",
          "label": "Lime wheel",
          "phrase": "a lime wheel",
          "ingredients": [{ "name": "lime wheel", "amount": 1, "unit": "count" }],
          "color": "#a3e635"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "muddle-berries",
      "text": "Muddle the {strawberry} in a shaker tin until they are crushed and juicy.",
      "tools": ["muddler", "shaker"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb} and press them gently with the muddler, just enough to bruise them.",
      "tools": ["muddler"],
      "when": { "slot": "herb" }
    },
    {
      "id": "add-base",
      "text": "Add the lime juice and {sweetener}.",
      "tools": ["jigger"]
    },
    {
      "id": "shake",
      "text": "Fill the tin with ice and shake hard for about 10 seconds.",
      "tools": ["shaker"]
    },
    { "id": "fill-glass", "text": "Fill a highball glass with fresh ice." },
    {
      "id": "strain",
      "text": "Double strain into the glass, through the shaker strainer and a fine strainer, to catch the seeds and bits of leaf.",
      "tools": ["strainer", "fine-strainer"]
    },
    {
      "id": "top",
      "text": "Top with {fizz} and stir once with a barspoon.",
      "tools": ["barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "strawberry": "fresh-strawberries",
    "herb": "mint",
    "sweetener": "simple-syrup",
    "fizz": "soda-water",
    "garnish": "fresh-strawberry"
  }
}
