  "steps": [
    {
      "id": "warm-milk",
      "text": "Put the {milk}, turmeric, a pinch of black pepper and a pinch of cardamom in a small pot over medium heat."
    },
    {
      "id": "heat",
      "text": "Stir now and then until it steams, without letting it boil. The pepper helps the turmeric's flavor come through."
    },
    {
      "id": "add-sweetener",
      "text": "Take it off the heat and stir in the {sweetener}.",
      "tools": ["jigger", "barspoon"]
    },
    { "id": "pour", "text": "Pour into a mug." },
