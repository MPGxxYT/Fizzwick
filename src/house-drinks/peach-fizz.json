  "steps": [
    {
      "id": "muddle-peach",
      "text": "Muddle the peach slices in a shaker tin until soft and juicy.",
      "tools": ["muddler", "shaker"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb} and press them gently with the muddler, just enough to bruise them.",
      "tools": ["muddler"],
      "when": { "slot": "herb" }
    },
    {
      "id": "add-base",
      "text": "Add the lemon juice and {sweetener}.",
      "tools": ["jigger"]
    },
    {
      "id": "shake",
      "text": "Fill the tin with ice and shake hard for about 10 seconds.",
      "tools": ["shaker"]
    },
    { "id": "fill-glass", "text": "Fill a highball glass with fresh ice." },
    {
      "id": "strain",
      "text": "Double strain into the glass, through the shaker strainer and a fine strainer, to catch the bits of peach and leaf.",
      "tools": ["strainer", "fine-strainer"]
    },
    {
      "id": "top",
      "text": "Top with {fizz} and stir once with a barspoon.",
      "tools": ["barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "peach": "ripe-peach",
    "herb": "basil",
    "sweetener": "simple-syrup",
    "fizz": "soda-water",
    "garnish": "peach-slice"
