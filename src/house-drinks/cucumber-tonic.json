{
  "formatVersion": 1,
  "id": "cucumber-tonic",
  "name": "Cucumber Tonic",
  "glass": "highball",
  "method": "build",
  "flavorTags": ["bitter", "herbal"],
  "photo": "photos/cucumber-tonic.jpg",
  "ingredients": [{ "name": "ice", "unit": "fill" }],
  "slots": [
    {
      "id": "cucumber",
      "label": "Cucumber",
      "options": [
        {
          "id": "cucumber-ribbons",
          "label": "Cucumber ribbons",
          "ingredients": [{ "name": "long cucumber ribbons", "amount": 3, "unit": "count" }],
          "color": "#bbf7d0"
        },
        {
          "id": "cucumber-slices",
          "label": "Cucumber slices",
          "ingredients": [{ "name": "thin cucumber slices", "amount": 4, "unit": "count" }],
          "color": "#86efac"
        }
      ]
    },
    {
      "id": "tonic",
      "label": "Tonic",
      "options": [
        {
          "id": "tonic",
          "label": "Tonic",
          "phrase": "tonic",
          "ingredients": [{ "name": "tonic", "unit": "top" }],
          "color": "#eef6f8"
        },
        {
          "id": "elderflower-tonic",
          "label": "Elderflower tonic",
          "phrase": "elderflower tonic",
          "ingredients": [{ "name": "elderflower tonic", "unit": "top" }],
          "color": "#f4f1dc"
        }
      ]
    },
    {
      "id": "citrus",
      "label": "Citrus",
      "options": [
        {
          "id": "lime-wedge",
          "label": "Lime wedge",
          "phrase": "lime wedge",
          "ingredients": [{ "name": "lime wedge", "amount": 1, "unit": "count" }],
          "color": "#84cc16"
        },
        {
          "id": "lemon-wedge",
          "label": "Lemon wedge",
          "phrase": "lemon wedge",
          "ingredients": [{ "name": "lemon wedge", "amount": 1, "unit": "count" }],
          "color": "#fde047"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "ribbon-cucumber",
      "text": "Shave long cucumber ribbons down the length of a cucumber with a peeler, then curl them around the inside of a highball glass.",
      "tools": ["peeler"],
      "when": { "slot": "cucumber", "option": "cucumber-ribbons" }
    },
    {
      "id": "add-slices",
      "text": "Drop the thin cucumber slices into a highball glass.",
      "when": { "slot": "cucumber", "option": "cucumber-slices" }
    },
    { "id": "fill-glass", "text": "Fill the glass with ice, holding the cucumber against the sides." },
    { "id": "top", "text": "Top with {tonic}." },
    { "id": "garnish", "text": "Squeeze the {citrus} over the drink and drop it in." }
  ],
  "houseSpec": {
    "cucumber": "cucumber-ribbons",
    "tonic": "tonic",
    "citrus": "lime-wedge"
  }
}
