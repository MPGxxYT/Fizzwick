{
  "formatVersion": 1,
  "id": "watermelon-agua-fresca",
  "name": "Watermelon Agua Fresca",
  "glass": "collins",
  "method": "blend",
  "flavorTags": ["fruity"],
  "shelf": "iced-tea-coolers",
  "added": "2026-11-05",
  "photo": "photos/watermelon-agua-fresca.jpg",
  "sip": { "by": "rim", "why": "so you smell the garnish as you sip." },
  "ingredients": [
    { "name": "seedless watermelon chunks", "amount": 1, "unit": "cup" },
    { "name": "cold water", "amount": 2, "unit": "oz" },
    { "name": "fresh lime juice", "amount": 0.5, "unit": "oz" },
    { "name": "ice", "unit": "fill" }
  ],
  "slots": [
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.5, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "agave",
          "label": "Agave",
          "phrase": "agave",
          "ingredients": [{ "name": "agave", "amount": 0.25, "unit": "oz" }],
          "color": "#d9a441"
        },
        {
          "id": "honey-syrup",
          "label": "Honey syrup",
          "phrase": "honey syrup",
          "ingredients": [{ "name": "honey syrup", "amount": 0.5, "unit": "oz" }],
          "color": "#e0a43a"
        }
      ]
    },
    {
      "id": "herb",
      "label": "Herb",
      "optional": true,
      "options": [
        {
          "id": "mint",
          "label": "Mint",
          "phrase": "mint leaves",
          "ingredients": [{ "name": "mint leaves", "amount": 6, "unit": "count", "size": { "each": "thumbnail-size" } }],
          "color": "#6fcf6a"
        },
        {
          "id": "basil",
          "label": "Basil",
          "phrase": "basil leaves",
          "ingredients": [{ "name": "basil leaves", "amount": 2, "unit": "count", "size": { "each": "thumb-length" } }],
          "color": "#3f9d4a"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "lime-wheel",
          "label": "Lime wheel",
          "phrase": "a lime wheel on the rim",
          "ingredients": [{ "name": "lime wheel", "amount": 1, "unit": "count" }],
          "color": "#a3e635"
        },
        {
          "id": "mint-sprig",
          "label": "Mint sprig",
          "phrase": "a mint sprig tucked into the ice",
          "ingredients": [{ "name": "mint sprig", "amount": 1, "unit": "count" }],
          "color": "#4d9a4a"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "fill-blender",
      "text": "Put the watermelon chunks, cold water, lime juice and {sweetener} in a blender.",
      "tools": ["blender", "jigger"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb}.",
      "when": { "slot": "herb" }
    },
    {
      "id": "blend",
      "text": "Blend until smooth.",
      "tools": ["blender"]
    },
    {
      "id": "strain",
      "text": "Pour it through a fine strainer into a jug, pressing the pulp to get all the juice out.",
      "tools": ["fine-strainer"]
    },
    { "id": "fill-glass", "text": "Fill a collins glass with ice." },
    { "id": "pour", "text": "Pour the agua fresca over the ice." },
    {
      "id": "garnish",
      "text": "Finish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "sweetener": "simple-syrup",
    "herb": "mint",
    "garnish": "lime-wheel"
  }
}
