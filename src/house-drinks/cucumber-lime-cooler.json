  "ingredients": [
    { "name": "thin cucumber slices", "amount": 4, "unit": "count" },
    { "name": "fresh lime juice", "amount": 0.5, "unit": "oz" },
    { "name": "ice", "unit": "fill" }
  ],
  "slots": [
    {
      "id": "herb",
      "label": "Herb",
      "optional": true,
      "options": [
        {
          "id": "mint",
          "label": "Mint",
          "phrase": "mint leaves",
          "ingredients": [{ "name": "mint leaves", "amount": 6, "unit": "count" }],
          "color": "#6fcf6a"
        },
        {
          "id": "basil",
          "label": "Basil",
          "phrase": "basil leaves",
          "ingredients": [{ "name": "basil leaves", "amount": 2, "unit": "count" }],
          "color": "#3f9d4a"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "agave",
          "label": "Agave",
          "phrase": "agave",
          "ingredients": [{ "name": "agave", "amount": 0.25, "unit": "oz" }],
          "color": "#d9a441"
        }
      ]
    },
    {
      "id": "fizz",
      "label": "Fizz",
      "options": [
        {
          "id": "soda-water",
          "label": "Soda water",
          "phrase": "soda water",
          "ingredients": [{ "name": "soda water", "unit": "top" }],
          "color": "#e0f2fe"
        },
        {
          "id": "tonic-water",
          "label": "Tonic water",
          "phrase": "tonic water",
          "ingredients": [{ "name": "tonic water", "unit": "top" }],
          "color": "#eef6f8"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "lime-wheel",
          "label": "Lime wheel",
          "phrase": "a lime wheel",
          "ingredients": [{ "name": "lime wheel", "amount": 1, "unit": "count" }],
          "color": "#84cc16"
        },
        {
          "id": "mint-sprig",
          "label": "Mint sprig",
          "phrase": "a mint sprig",
          "ingredients": [{ "name": "mint sprig", "amount": 1, "unit": "count" }],
          "color": "#4ade80"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "muddle-cucumber",
      "text": "Muddle the cucumber slices in a Collins glass until they break up.",
      "tools": ["muddler"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb} and press them gently with the muddler, just enough to bruise them.",
      "tools": ["muddler"],
      "when": { "slot": "herb" }
    },
    {
      "id": "add-base",
      "text": "Add the lime juice and {sweetener}, and stir to mix.",
      "tools": ["jigger", "barspoon"]
    },
    { "id": "fill-glass", "text": "Fill the glass with ice." },
    {
      "id": "top",
      "text": "Top with {fizz} and stir gently from the bottom up.",
      "tools": ["barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "herb": "mint",
    "sweetener": "simple-syrup",
    "fizz": "soda-water",
    "garnish": "lime-wheel"
