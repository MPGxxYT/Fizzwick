{
  "formatVersion": 1,
  "id": "cucumber-lime-cooler",
  "name": "Cucumber Lime Cooler",
  "glass": "collins",
  "method": "build",
  "flavorTags": ["herbal", "citrus"],
  "shelf": "iced-tea-coolers",
  "added": "2026-11-06",
