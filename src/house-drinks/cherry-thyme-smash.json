{
  "formatVersion": 1,
  "id": "cherry-thyme-smash",
  "name": "Cherry Thyme Smash",
  "glass": "rocks",
  "method": "shake",
  "flavorTags": ["fruity", "herbal"],
  "shelf": "smashes",
  "added": "2026-11-06",
  "photo": "photos/cherry-thyme-smash.jpg",
  "sip": { "by": "straw", "why": "since crushed ice packs in too tight to sip over. Keep it short, so your nose stays near the garnish." },
  "ingredients": [
    { "name": "fresh cherries, pitted", "amount": 6, "unit": "count", "size": { "each": "grape-size" } },
    { "name": "fresh lemon juice", "amount": 0.5, "unit": "oz" },
    { "name": "crushed ice", "unit": "fill" },
    { "name": "soda water", "amount": 2, "unit": "oz" }
  ],
  "slots": [
    {
      "id": "herb",
      "label": "Herb",
      "optional": true,
      "options": [
        {
          "id": "thyme",
          "label": "Thyme",
          "phrase": "thyme sprigs",
          "ingredients": [{ "name": "thyme sprigs", "amount": 2, "unit": "count", "size": { "each": "finger-length" } }],
          "color": "#6b8e4e"
        },
        {
          "id": "basil",
          "label": "Basil",
          "phrase": "basil leaves",
          "ingredients": [{ "name": "basil leaves", "amount": 2, "unit": "count", "size": { "each": "thumb-length" } }],
          "color": "#3f9d4a"
        },
        {
          "id": "mint",
          "label": "Mint",
          "phrase": "mint leaves",
          "ingredients": [{ "name": "mint leaves", "amount": 6, "unit": "count", "size": { "each": "thumbnail-size" } }],
          "color": "#6fcf6a"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "demerara-syrup",
          "label": "Demerara syrup",
          "phrase": "demerara syrup",
          "ingredients": [{ "name": "demerara syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#b7793a"
        },
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "honey-syrup",
          "label": "Honey syrup",
          "phrase": "honey syrup",
          "ingredients": [{ "name": "honey syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#e0a43a"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "thyme-sprig",
          "label": "Thyme sprig",
          "phrase": "a thyme sprig",
          "ingredients": [{ "name": "thyme sprig, for garnish", "amount": 1, "unit": "count" }],
          "color": "#6b8e4e"
        },
        {
          "id": "cherry",
          "label": "Cocktail cherry",
          "phrase": "a cocktail cherry",
          "ingredients": [{ "name": "cocktail cherry", "amount": 1, "unit": "count" }],
          "color": "#7f1d1d"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "muddle-cherries",
      "text": "Muddle the cherries in a shaker tin until they burst.",
      "tools": ["muddler", "shaker"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb} and press them gently with the muddler, just enough to bruise them.",
      "tools": ["muddler"],
      "when": { "slot": "herb" }
    },
    {
      "id": "add-base",
      "text": "Add the lemon juice and {sweetener}.",
      "tools": ["jigger"]
    },
    {
      "id": "shake",
      "text": "Fill the tin with ice and shake hard for about 10 seconds.",
      "tools": ["shaker"]
    },
    { "id": "fill-glass", "text": "Fill a rocks glass with crushed ice." },
    {
      "id": "strain",
      "text": "Double strain into the glass, through the shaker strainer and a fine strainer, to catch the bits of skin and leaf.",
      "tools": ["strainer", "fine-strainer"]
    },
    {
      "id": "add-soda",
      "text": "Pour the soda water over the top and stir with a barspoon, lifting from the bottom so it mixes in.",
      "tools": ["jigger", "barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "herb": "thyme",
    "sweetener": "demerara-syrup",
    "garnish": "thyme-sprig"
  }
}
