  "ingredients": [{ "name": "fresh lemon juice", "amount": 0.5, "unit": "oz" }],
  "slots": [
    {
      "id": "base",
      "label": "Base",
      "options": [
        {
          "id": "hot-water",
          "label": "Hot water",
          "phrase": "hot water",
          "ingredients": [{ "name": "just-boiled water", "amount": 6, "unit": "oz" }],
          "removeSteps": ["steep-tea"],
          "color": "#f2e6c9"
        },
        {
          "id": "rooibos",
          "label": "Hot rooibos",
