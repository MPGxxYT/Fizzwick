          "ingredients": [
            { "name": "just-boiled water", "amount": 6, "unit": "oz" },
            { "name": "rooibos tea bag", "amount": 1, "unit": "count" }
          ],
          "color": "#b5562b"
        },
        {
          "id": "chamomile",
          "label": "Hot chamomile",
          "phrase": "chamomile",
          "ingredients": [
            { "name": "just-boiled water", "amount": 6, "unit": "oz" },
            { "name": "chamomile tea bag", "amount": 1, "unit": "count" }
          ],
          "color": "#e9c46a"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "honey",
          "label": "Honey",
          "phrase": "honey",
          "ingredients": [{ "name": "honey", "amount": 0.75, "unit": "oz" }],
          "color": "#e8b04a"
        },
        {
          "id": "ginger-syrup",
          "label": "Ginger syrup",
          "phrase": "ginger syrup",
          "ingredients": [{ "name": "ginger syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#d9a441"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "options": [
        {
          "id": "clove-lemon",
          "label": "Lemon wheel studded with cloves",
          "phrase": "a lemon wheel studded with cloves, floating on top",
          "ingredients": [
            { "name": "lemon wheel", "amount": 1, "unit": "count" },
            { "name": "whole cloves", "amount": 4, "unit": "count" }
          ],
          "color": "#facc15"
        },
        {
          "id": "cinnamon-stick",
          "label": "Cinnamon stick",
          "phrase": "a cinnamon stick to stir with",
          "ingredients": [{ "name": "cinnamon stick", "amount": 1, "unit": "count" }],
          "color": "#8b4a24"
        }
      ]
    }
  ],
  "steps": [
    {
