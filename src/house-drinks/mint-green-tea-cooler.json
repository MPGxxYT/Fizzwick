          "color": "#e0a43a"
        },
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.75, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "agave",
          "label": "Agave",
          "phrase": "agave",
          "ingredients": [{ "name": "agave", "amount": 0.25, "unit": "oz" }],
