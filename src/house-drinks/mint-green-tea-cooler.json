        {
          "id": "mint-sprig",
          "label": "Mint sprig",
          "phrase": "a mint sprig",
          "ingredients": [{ "name": "mint sprig", "amount": 1, "unit": "count" }],
          "color": "#4ade80"
        },
        {
          "id": "lemon-wheel",
          "label": "Lemon wheel",
