    },
    {
      "id": "add-lemon",
      "text": "Add the lemon juice.",
      "tools": ["jigger"]
    },
    { "id": "fill-glass", "text": "Fill the glass with ice." },
    {
      "id": "pour-tea",
      "text": "Pour the {tea} over the ice and stir to mix.",
      "tools": ["jigger", "barspoon"]
    },
    {
      "id": "top",
      "text": "Top with a splash of {fizz}.",
      "when": { "slot": "fizz" }
    },
    { "id": "garnish", "text": "Garnish with {garnish}." }
  ],
  "houseSpec": {
    "tea": "green-tea",
    "sweetener": "honey-syrup",
