  "steps": [
    {
      "id": "brew-tea",
      "text": "Steep the {tea} in just-boiled water, then strain it and chill it in the fridge. Make it ahead if you can.",
      "tools": ["kettle"],
      "durationSeconds": 180
    },
    {
      "id": "muddle-mint",
      "text": "Press the mint leaves gently in a Collins glass with the {sweetener}, just enough to bruise them.",
