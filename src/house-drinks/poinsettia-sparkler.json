      "tools": ["jigger"]
    },
    {
      "id": "top",
      "text": "Top slowly with chilled {fizz}, tilting the glass so it keeps its bubbles."
    },
    {
      "id": "garnish",
      "text": "Finish with {garnish}.",
      "when": { "slot": "garnish" }
    }
