{
  "formatVersion": 1,
  "id": "poinsettia-sparkler",
  "name": "Poinsettia Sparkler",
  "glass": "coupe",
  "method": "build",
  "flavorTags": ["fruity", "citrus"],
  "shelf": "fizzy-fruity",
  "added": "2026-11-09",
  "photo": "photos/poinsettia-sparkler.jpg",
