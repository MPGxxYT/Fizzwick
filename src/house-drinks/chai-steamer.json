{
  "formatVersion": 1,
  "id": "chai-steamer",
  "name": "Chai Steamer",
  "glass": "mug",
  "method": "build",
  "flavorTags": ["spicy", "creamy"],
  "shelf": "warm-savory",
  "added": "2026-11-06",
  "photo": "photos/chai-steamer.jpg",
  "sip": { "by": "rim", "why": "so you smell the spices. A straw sends the heat straight to your tongue." },
  "ingredients": [{ "name": "chai syrup", "amount": 0.75, "unit": "oz" }],
  "slots": [
    {
      "id": "milk",
      "label": "Milk",
      "options": [
        {
          "id": "whole-milk",
          "label": "Whole milk",
          "phrase": "whole milk",
          "ingredients": [{ "name": "whole milk", "amount": 6, "unit": "oz" }],
          "dietaryTags": ["dairy"],
          "color": "#fbfaf5"
        },
        {
          "id": "oat-milk",
          "label": "Oat milk",
          "phrase": "oat milk",
          "ingredients": [{ "name": "oat milk", "amount": 6, "unit": "oz" }],
          "color": "#eadfc8"
        },
        {
          "id": "almond-milk",
          "label": "Almond milk",
          "phrase": "almond milk",
          "ingredients": [{ "name": "almond milk", "amount": 6, "unit": "oz" }],
          "dietaryTags": ["nuts"],
          "color": "#efe4d2"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "cinnamon",
          "label": "Ground cinnamon",
          "phrase": "a pinch of ground cinnamon",
          "ingredients": [{ "name": "ground cinnamon", "unit": "to-taste" }],
          "color": "#8b4a24"
        },
        {
          "id": "cinnamon-stick",
          "label": "Cinnamon stick",
          "phrase": "a cinnamon stick to stir with",
          "ingredients": [{ "name": "cinnamon stick", "amount": 1, "unit": "count" }],
          "color": "#8b4a24"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "warm-milk",
      "text": "Warm the {milk} in a small pot over medium heat until it steams, without letting it boil."
    },
    {
      "id": "add-syrup",
      "text": "Pour the chai syrup into a mug.",
      "tools": ["jigger"]
    },
    {
      "id": "pour-milk",
      "text": "Pour in the hot {milk} and stir until the syrup is mixed in.",
      "tools": ["barspoon"]
    },
    {
      "id": "garnish",
      "text": "Finish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "milk": "whole-milk",
    "garnish": "cinnamon"
  }
}
