{
  "formatVersion": 1,
  "id": "blueberry-fizz",
  "name": "Blueberry Fizz",
  "glass": "highball",
  "method": "shake",
  "flavorTags": ["fruity", "citrus"],
  "photo": "photos/blueberry-fizz.jpg",
  "ingredients": [
    { "name": "ice", "unit": "fill" },
    { "name": "fresh lemon juice", "amount": 0.75, "unit": "oz" }
  ],
  "slots": [
    {
      "id": "blueberry",
      "label": "Blueberry",
      "options": [
        {
          "id": "fresh-blueberries",
          "label": "Fresh blueberries",
          "phrase": "blueberries",
          "ingredients": [{ "name": "fresh blueberries", "amount": 15, "unit": "count" }],
          "color": "#4338ca"
        },
        {
          "id": "blueberry-syrup",
          "label": "Blueberry syrup",
          "phrase": "blueberry syrup",
          "ingredients": [{ "name": "blueberry syrup", "amount": 0.75, "unit": "oz" }],
          "removeSteps": ["muddle-berries"],
          "addSteps": [
            {
              "step": {
                "id": "add-syrup",
                "text": "Pour the blueberry syrup into a shaker tin.",
                "tools": ["shaker", "jigger"]
              }
            }
          ],
          "color": "#5b2a86"
        }
      ]
    },
    {
      "id": "herb",
      "label": "Herb",
      "optional": true,
      "options": [
        {
          "id": "basil",
          "label": "Basil",
          "phrase": "basil leaves",
          "ingredients": [{ "name": "basil leaves", "amount": 4, "unit": "count" }],
          "color": "#3f9d4a"
        },
        {
          "id": "mint",
          "label": "Mint",
          "phrase": "mint leaves",
          "ingredients": [{ "name": "mint leaves", "amount": 6, "unit": "count" }],
          "color": "#6fcf6a"
        }
      ]
    },
    {
      "id": "sweetener",
      "label": "Sweetener",
      "options": [
        {
          "id": "honey-syrup",
          "label": "Honey syrup",
          "phrase": "honey syrup",
          "ingredients": [{ "name": "honey syrup", "amount": 0.5, "unit": "oz" }],
          "color": "#e0a43a"
        },
        {
          "id": "simple-syrup",
          "label": "Simple syrup",
          "phrase": "simple syrup",
          "ingredients": [{ "name": "simple syrup", "amount": 0.5, "unit": "oz" }],
          "color": "#f5f5f4"
        },
        {
          "id": "lavender-syrup",
          "label": "Lavender syrup",
          "phrase": "lavender syrup",
          "ingredients": [{ "name": "lavender syrup", "amount": 0.5, "unit": "oz" }],
          "color": "#b49be0"
        }
      ]
    },
    {
      "id": "fizz",
      "label": "Fizz",
      "options": [
        {
          "id": "soda-water",
          "label": "Soda water",
          "phrase": "soda water",
          "ingredients": [{ "name": "soda water", "unit": "top" }],
          "color": "#e0f2fe"
        },
        {
          "id": "lemon-lime-soda",
          "label": "Lemon-lime soda",
          "phrase": "lemon-lime soda",
          "ingredients": [{ "name": "lemon-lime soda", "unit": "top" }],
          "color": "#e7f5c4"
        },
        {
          "id": "ginger-ale",
          "label": "Ginger ale",
          "phrase": "ginger ale",
          "ingredients": [{ "name": "ginger ale", "unit": "top" }],
          "color": "#f1d38a"
        }
      ]
    },
    {
      "id": "garnish",
      "label": "Garnish",
      "optional": true,
      "options": [
        {
          "id": "blueberry-pick",
          "label": "Blueberries on a pick",
          "phrase": "a few blueberries on a cocktail pick",
          "ingredients": [{ "name": "blueberries, on a cocktail pick", "amount": 3, "unit": "count" }],
          "color": "#4f46e5"
        },
        {
          "id": "lemon-wheel",
          "label": "Lemon wheel",
          "phrase": "a lemon wheel",
          "ingredients": [{ "name": "lemon wheel", "amount": 1, "unit": "count" }],
          "color": "#fde047"
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "muddle-berries",
      "text": "Muddle the blueberries in a shaker tin until they burst.",
      "tools": ["muddler", "shaker"]
    },
    {
      "id": "add-herb",
      "text": "Add the {herb} and press them gently with the muddler, just enough to bruise them.",
      "tools": ["muddler"],
      "when": { "slot": "herb" }
    },
    {
      "id": "add-base",
      "text": "Add the lemon juice and {sweetener}.",
      "tools": ["jigger"]
    },
    {
      "id": "shake",
      "text": "Fill the tin with ice and shake hard for about 10 seconds.",
      "tools": ["shaker"]
    },
    { "id": "fill-glass", "text": "Fill a highball glass with fresh ice." },
    {
      "id": "strain",
      "text": "Double strain into the glass, through the shaker strainer and a fine strainer, to catch the skins and bits of leaf.",
      "tools": ["strainer", "fine-strainer"]
    },
    {
      "id": "top",
      "text": "Top with {fizz} and stir once with a barspoon.",
      "tools": ["barspoon"]
    },
    {
      "id": "garnish",
      "text": "Garnish with {garnish}.",
      "when": { "slot": "garnish" }
    }
  ],
  "houseSpec": {
    "blueberry": "fresh-blueberries",
    "herb": "basil",
    "sweetener": "honey-syrup",
    "fizz": "soda-water",
    "garnish": "blueberry-pick"
  }
}
